an&gt;[ Networking ]&lt;/span&gt;&#xA;&#xA;            &#xA;&#xA;            &lt;span&gt;[ Git ]&lt;/span&gt;&#xA;&#xA;            &#xA;&#xA;            &lt;span&gt;[ OverTheWire ]&lt;/span&gt;&#xA;&#xA;            &#xA;&#xA;        &lt;/div&gt;&#xA;&#xA;        &#xA;&#xA;&#xA;        &#xA;&#xA;&#xA;        &lt;div class=&#34;project-card-footer&#34;&gt;&#xA;&#xA;            &#xA;&#xA;                &lt;a href=&#34;http://localhost:1313/es/projects/bandit/&#34;&gt;&#xA;                    Ver proyecto →&#xA;                &lt;/a&gt;&#xA;&#xA;            &#xA;&#xA;        &lt;/div&gt;&#xA;&#xA;    &lt;/article&gt;&#xA;&#xA;    &#xA;&#xA;&lt;/div&gt;&#xA;&lt;/p&gt;</description>
